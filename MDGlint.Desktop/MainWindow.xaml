<Window x:Class="MDGlint.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MDGlint"
        Height="720"
        Width="1080"
        MinHeight="420"
        MinWidth="640"
        AllowDrop="True"
        Background="#ffffff"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="ToolbarForegroundBrush" Color="#1F2328" />
        <SolidColorBrush x:Key="ToolbarMutedBrush" Color="#59636E" />
        <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#EAEEF2" />
        <SolidColorBrush x:Key="ToolbarPressedBrush" Color="#D0D7DE" />
        <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFF8C5" />
        <SolidColorBrush x:Key="NoticeBorderBrush" Color="#E3C26B" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ToolbarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ToolbarPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#388BFD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1158C7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Header"
                Grid.Row="0"
                Background="#f6f8fa"
                BorderBrush="#d0d7de"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FileNameText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ToolbarForegroundBrush}"
                           TextTrimming="CharacterEllipsis"><Run Text="MDGlint" /><Run x:Name="VersionRun" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource ToolbarMutedBrush}" /></TextBlock>

                <Button x:Name="OpenButton" Grid.Column="1" Margin="3,0,0,0" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Open" Click="OpenButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource ToolbarForegroundBrush}" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M4,2 L10,2 L13,5 L13,14 L4,14 Z M10,2 L10,5 L13,5" />
                        <TextBlock Text="Open" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ReloadButton" Grid.Column="2" Margin="3,0,0,0" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Reload" Click="ReloadButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource ToolbarForegroundBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2,8 A 6,6 0 1 1 4,12.2 M 4,9 L 4,12.2 L 1,12.2" />
                        <TextBlock Text="Reload" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="RemoteButton"
                        Grid.Column="3"
                        Margin="3,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Remote content"
                        Click="RemoteButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" Stroke="{DynamicResource ToolbarForegroundBrush}" StrokeThickness="1.3" />
                            <Path Stroke="{DynamicResource ToolbarForegroundBrush}" StrokeThickness="1.1" Data="M7,0.7 C3.5,4 3.5,10 7,13.3 M7,0.7 C10.5,4 10.5,10 7,13.3 M0.7,7 L13.3,7" />
                        </Grid>
                        <TextBlock x:Name="RemoteButtonLabel" Text="Remote off" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ThemeButton" Grid.Column="4" Margin="3,0,0,0" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Theme" Click="ThemeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" Stroke="{DynamicResource ToolbarForegroundBrush}" StrokeThickness="1.3" />
                            <Path Fill="{DynamicResource ToolbarForegroundBrush}" Data="M7,0.7 A6.3,6.3 0 0 0 7,13.3 Z" />
                        </Grid>
                        <TextBlock x:Name="ThemeButtonLabel" Text="Dark" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="MoreButton"
                        Grid.Column="5"
                        Margin="3,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="More"
                        ToolTip="More"
                        Click="MoreButton_Click">
                    <StackPanel Orientation="Horizontal" Height="14" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource ToolbarForegroundBrush}" />
                        <Ellipse Width="3" Height="3" Margin="2.5,0" Fill="{DynamicResource ToolbarForegroundBrush}" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource ToolbarForegroundBrush}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="PrintMenuItem"
                                      Header="Print…"
                                      InputGestureText="Ctrl+P"
                                      Click="PrintMenuItem_Click" />
                            <MenuItem x:Name="ExportMenuItem" Header="Export">
                                <MenuItem x:Name="ExportPdfMenuItem"
                                          Header="PDF…"
                                          Click="ExportPdfMenuItem_Click" />
                            </MenuItem>
                            <MenuItem x:Name="CopyMarkdownMenuItem"
                                      Header="Copy Markdown"
                                      InputGestureText="Ctrl+Shift+C"
                                      Click="CopyMarkdownMenuItem_Click" />
                            <MenuItem x:Name="PrintLightMenuItem"
                                      Header="Print in light theme"
                                      IsCheckable="True"
                                      Click="PrintLightMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="AutoUpdateMenuItem"
                                      Header="Check for updates automatically"
                                      IsCheckable="True"
                                      Click="AutoUpdateMenuItem_Click" />
                            <MenuItem x:Name="CheckNowMenuItem"
                                      Header="Check for updates now"
                                      Click="CheckNowMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <!-- Shown when the open file tried to load images, video or audio from the internet. -->
        <Border x:Name="RemoteBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource NoticeBackgroundBrush}"
                BorderBrush="{DynamicResource NoticeBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ToolbarForegroundBrush}"
                           Text="Remote content blocked. Loading it would let its server see that, and when, you opened this file." />

                <Button x:Name="LoadRemoteButton" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Load for this file" Click="LoadRemoteForFile_Click">
                    <TextBlock Text="Load for this file" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                </Button>

                <Button x:Name="AlwaysAllowButton" Grid.Column="2" Margin="3,0,0,0" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Always allow" Click="AlwaysAllowRemote_Click">
                    <TextBlock Text="Always allow" FontSize="13" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                </Button>

                <Button x:Name="DismissRemoteButton"
                        Grid.Column="3"
                        Margin="3,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Dismiss"
                        ToolTip="Dismiss"
                        Click="DismissRemoteBar_Click">
                    <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource ToolbarForegroundBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,0 L10,10 M10,0 L0,10" />
                </Button>
            </Grid>
        </Border>

        <!-- Update checks, downloads and their results. Nothing installs until Install is pressed. -->
        <Border x:Name="UpdateBar"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{DynamicResource NoticeBackgroundBrush}"
                BorderBrush="{DynamicResource NoticeBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="UpdateBarText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ToolbarForegroundBrush}" />

                <Button x:Name="UpdateInstallButton"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="Downloads the update, checks it, then closes MDGlint, installs it and opens MDGlint again."
                        Click="UpdateInstall_Click">
                    <TextBlock x:Name="UpdateInstallLabel" Text="Install" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                </Button>

                <Button x:Name="UpdateNotesButton" Grid.Column="2" Margin="3,0,0,0" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Release notes" Click="UpdateNotes_Click">
                    <TextBlock Text="Release notes" FontSize="13" Foreground="{DynamicResource ToolbarForegroundBrush}" />
                </Button>

                <Button x:Name="UpdateDismissButton"
                        Grid.Column="3"
                        Margin="3,0,0,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Dismiss update"
                        ToolTip="Dismiss"
                        Click="UpdateDismiss_Click">
                    <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource ToolbarForegroundBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,0 L10,10 M10,0 L0,10" />
                </Button>
            </Grid>
        </Border>

        <!-- Shown until the preview has started, so the window is never blank while it loads. -->
        <TextBlock x:Name="PreviewStartingText"
                   Grid.Row="3"
                   Text="Starting the preview…"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{DynamicResource ToolbarMutedBrush}" />

        <wv2:WebView2 x:Name="PreviewBrowser" Grid.Row="3" />

        <!-- Shown instead of the preview when the WebView2 Runtime is missing or fails to start. -->
        <ScrollViewer x:Name="PreviewUnavailablePanel"
                      Grid.Row="3"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" Margin="32" VerticalAlignment="Center">
                <TextBlock x:Name="PreviewUnavailableTitle"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ToolbarForegroundBrush}" />
                <TextBlock x:Name="PreviewUnavailableMessage"
                           Margin="0,12,0,0"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ToolbarForegroundBrush}" />
                <Button x:Name="DownloadWebView2Button"
                        HorizontalAlignment="Left"
                        Margin="0,20,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="DownloadWebView2_Click">
                    <TextBlock Text="Get WebView2 from Microsoft" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                </Button>
                <Button x:Name="EndStuckPreviewButton"
                        HorizontalAlignment="Left"
                        Margin="0,20,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="End it and try again"
                        Click="EndStuckPreview_Click">
                    <TextBlock Text="End it and try again" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                </Button>
                <TextBlock x:Name="PreviewUnavailableLink"
                           Margin="0,10,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ToolbarMutedBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
